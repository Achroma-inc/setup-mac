# 全社端末セットアップ用 Brewfile
#
#   brew bundle install --file=Brewfile
#
# 導入手順は README.md を参照。
# Bluedot は Homebrew に cask が存在しないため手動インストールする。

# ブラウザ
cask "google-chrome"

# コミュニケーション
cask "slack"
cask "zoom"
cask "microsoft-teams"

# Microsoft Office
cask "microsoft-excel"
cask "microsoft-powerpoint"
cask "microsoft-word"

# ドキュメント・ナレッジ
cask "notion"

# 開発
cask "visual-studio-code"

# AI
cask "claude"

# ユーティリティ
cask "rectangle"
